#!/usr/bin/env python3
"""bin/krok N — start a step: unlock its materials, tell the agent, show where you are.

ENGLISH TESTER BRANCH: the texts shown come from GUIDE_EN.md; the Polish page is the original.

`krok 3` starts step 03 part A, `krok 3b` its part B (only after the part-A discovery), likewise
for 07. Unlocking is cumulative: `krok 5` also fetches anything earlier that is still missing, so
`bin/sprawdz 5` can run the tests of steps 01–05. Materials of later steps stay off the disk.
Then it writes ~/work/project/.clinerules/aktualny-etap.md (the agent's pointer to the current
stage: its spec and tests, never the step page) and prints the step's "Where you are" and
"First action" sections from the English guide.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _warsztat import (  # noqa: E402
    PROJECT,
    TITLES,
    label,
    parse,
    plain,
    section,
    unit_dirs,
    units_upto,
    unlock,
    write_current,
)

USAGE = """Usage: ~/workshop/bin/krok N      (N = 1…8; steps 3 and 7 have a part B: 3b, 7b)

Starts a step: fetches its page, requirements and tests into ~/workshop, tells the agent which
stage is current, and shows where to begin."""


def main(argv: list[str]) -> int:
    unit = parse(argv, USAGE, part_a_of_split=True)
    need = units_upto(unit)
    fetched = unlock(need)
    if fetched:
        print("Fetched materials: " + ", ".join(label(u) for u in fetched) + ".")
    write_current(PROJECT, unit)

    steps_dir, specs_dir, tests_dir = unit_dirs(unit)
    rel = lambda p: "~/workshop/" + p.relative_to(steps_dir.parent.parent).as_posix()  # noqa: E731
    print(f"\n=== STEP {label(unit)}: {TITLES[unit]} ===\n")
    for title in ("Where you are", "First action"):
        text = section(unit, title)
        if text:
            print(f"— {title} —\n{plain(text)}\n")
    print(
        f"Step page (for you):       ~/workshop/GUIDE_EN.md, section \"Step {label(unit)}\"\n"
        f"  (Polish original:        {rel(steps_dir / 'README.md')})\n"
        f"Requirements (for agent):  {rel(specs_dir / 'spec.md')}  (Polish)\n"
        f"Tests:                     {rel(tests_dir)}/\n\n"
        "In Cline start a NEW task (the + button): a shorter conversation means better answers and\n"
        "lower cost. The agent already knows which stage of Tomasz's plan is in progress\n"
        "(.clinerules/aktualny-etap.md)."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
