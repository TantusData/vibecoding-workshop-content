#!/usr/bin/env python3
"""bin/checkpoint N — catch up: replace the project with the reference state at the END of step N.

ENGLISH TESTER BRANCH: a translation of the Polish course's bin/checkpoint. One difference: the
snapshot's Polish project files that this branch translated (the note, README, agent context,
chat page, example rules and look) are written in English (english_snapshot, english/swap.txt).

Contract (reversible in one command, bin/undo):
  1. commit everything in ~/work/project first — nothing the participant made is destroyed;
  2. fetch refs/checkpoints/NN from the remote into a throw-away bare repo — the snapshot is not
     on disk before this and nothing of it stays in ~/workshop afterwards;
  3. show what would be overwritten and ask for confirmation;
  4. copy the snapshot over the project, skipping every keep.txt path the participant changed;
  5. commit the result, and record the pre-checkpoint commit for bin/undo.
Files the participant added that the snapshot does not have are left alone.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _warsztat import (  # noqa: E402
    PROJECT,
    UNDO_FILE,
    commit_all,
    confirm,
    english_snapshot,
    ensure_project_repo,
    fetch_refs,
    is_participants,
    keep_patterns,
    label,
    parse,
    units_upto,
    unlock,
)

USAGE = """Usage: ~/workshop/bin/checkpoint N      (N = 1…8)

Replaces the project's code with the finished state at the END of step N (steps 3 and 7: with
part B). It first saves (commits) everything you have, so one command undoes it:
~/workshop/bin/undo. Your app look, your rules for the agent and your test set stay
(list: ~/workshop/keep.txt).

If you are missing only part of a step, try without a checkpoint first:
show the agent ~/workshop/specs/NN/spec.md and the output of ~/workshop/bin/sprawdz N."""


def main(argv: list[str]) -> int:
    unit = parse(argv, USAGE, part_a_of_split=False)
    n = int(unit[:2])
    assume_yes = "--tak" in argv
    project = PROJECT
    ensure_project_repo(project)
    patterns = keep_patterns()

    print(f"Fetching checkpoint {n:02d}…", flush=True)
    ref = f"refs/checkpoints/{n:02d}"
    snap = english_snapshot(fetch_refs([ref])[ref])
    paths = sorted(p for p in snap if not p.endswith("\0x"))

    new, changed, kept = [], [], []
    for rel in paths:
        mine = project / rel
        if is_participants(rel, project, patterns):
            if mine.read_bytes() != snap[rel]:
                kept.append(rel)
        elif not mine.exists():
            new.append(rel)
        elif mine.read_bytes() != snap[rel]:
            changed.append(rel)

    print(f"\nCheckpoint {n:02d} = the finished project state after step {n:02d}.")
    if not new and not changed:
        print("The project already has exactly these files — nothing to do.")
        unlock(units_upto(unit))
        return 0
    print(f"\nFiles to be OVERWRITTEN: {len(changed)}")
    for rel in changed[:40]:
        print(f"  ~ {rel}")
    if len(changed) > 40:
        print(f"  … and {len(changed) - 40} more")
    print(f"Files to be ADDED: {len(new)}")
    for rel in new[:15]:
        print(f"  + {rel}")
    if len(new) > 15:
        print(f"  … and {len(new) - 15} more")
    if kept:
        print("Your files the checkpoint will NOT touch (keep.txt):")
        for rel in kept:
            print(f"  = {rel}")
    print(
        "\nFirst I will save (commit) the current state of the project, so everything can be undone:\n"
        "  ~/workshop/bin/undo\n"
        "Undo restores the files — but you and your agent will have seen the step's solution."
    )
    if not confirm("\nContinue? Type YES and Enter: ", assume_yes):
        print("Cancelled. Nothing was changed.")
        return 1

    before = commit_all(project, f"State before checkpoint {n:02d}")
    for rel in new + changed:
        dst = project / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_bytes(snap[rel])
        if rel + "\0x" in snap:
            dst.chmod(0o755)
    after = commit_all(project, f"Checkpoint {n:02d}: finished state after step {n:02d}")
    with (project / ".git" / UNDO_FILE).open("a", encoding="utf-8") as fh:
        fh.write(f"{n:02d} {before} {after}\n")
    opened = unlock(units_upto(unit))  # a jump ahead still gets the pages and tests up to N

    print(
        f"\nDone: the project is in its state after step {n:02d} "
        f"({len(changed)} overwritten, {len(new)} added files).\n"
        + (f"Fetched materials of steps: {', '.join(label(u) for u in opened)}.\n" if opened else "")
        + f"Check:  ~/workshop/bin/sprawdz {n}\n"
        "Undo:   ~/workshop/bin/undo\n"
        "If the app was running, restart it (Ctrl+C, then python -m opscopilot.webapp again)."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
