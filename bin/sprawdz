#!/usr/bin/env python3
"""bin/sprawdz N — is step N done? Runs the tests of every started step up to N on ~/work/project.

ENGLISH TESTER BRANCH: a translation of the Polish course's bin/sprawdz; same logic.

"Done" is a green run of this command, never a judgement call: the step's own tests plus every
earlier step's (so a later change that breaks an earlier step shows up). Always offline: the
model and the embeddings are faked, nothing is spent — so the agent may run it after every change.
`sprawdz 3a` checks step 03 part A only; `sprawdz 3` (= `3b`) the whole step once part B is
started. Refuses to run if the course material was changed — a tracked file under ~/workshop, or
an unlocked step file that no longer matches materialy.sha256: an agent that edits a test until it
passes has not finished the step. `bin/sprawdz przywroc` puts everything back.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _warsztat import (  # noqa: E402
    PROJECT,
    UNITS,
    WS,
    fail,
    git,
    label,
    parse,
    tampered_materials,
    unit_dirs,
    units_upto,
    unlock,
    unlocked,
)

USAGE = """Usage: ~/workshop/bin/sprawdz N      (N = 1…8; parts: 3a, 3b, 7a, 7b)

Runs the tests of the started steps up to and including N on your project (~/work/project). A
step is done when the result is PASSED. No model and no cost — everything runs locally."""


def tracked_changes() -> list[str]:
    r = git("status", "--porcelain", "--untracked-files=all", cwd=WS, check=False)
    return [
        ln for ln in r.stdout.splitlines() if "__pycache__" not in ln and ".pytest_cache" not in ln
    ]


def restore() -> int:
    git("checkout", "--", ".", cwd=WS)
    git("clean", "-q", "-fd", cwd=WS)  # untracked, not ignored: unlocked steps stay
    again = unlock([u for u in UNITS if unlocked(u)], force=True)
    print(
        "The course materials (~/workshop) are back in their original version"
        + (f" (fetched again: {', '.join(label(u) for u in again)})." if again else ".")
    )
    return 0


def main(argv: list[str]) -> int:
    if argv[:1] == ["przywroc"]:
        return restore()
    unit = parse(argv, USAGE, part_a_of_split=False)
    venv = Path("/opt/venv")
    if venv.is_dir() and not (venv / ".ready").exists():
        fail("Python on this machine is still installing (about 70 s after start). Try again soon.")
    if not PROJECT.is_dir():
        fail(f"There is no project folder {PROJECT}. Call the trainer.")

    # `sprawdz 3` before part B is started means: check part A
    if unit.endswith("b") and not unlocked(unit) and not any(a.lower().endswith("b") for a in argv):
        unit = unit[:2]
    if not unlocked(unit):
        fail(
            f"Step {label(unit)} has not been started yet. First:\n"
            f"  ~/workshop/bin/krok {int(unit[:2])}{'b' if unit.endswith('b') else ''}",
            4,
        )

    changed = tracked_changes() + tampered_materials()
    if changed:
        print(
            "STOP: someone (maybe the agent) changed the course materials in ~/workshop:\n"
            + "\n".join("  " + ln for ln in changed[:20])
            + "\n\nThe tests and step pages are the reference — changing them does not finish a step.\n"
            "We work only in ~/work/project. Restore the materials with:\n"
            "  ~/workshop/bin/sprawdz przywroc\n"
            "and run the check again.",
            file=sys.stderr,
        )
        return 3

    units = [u for u in units_upto(unit) if unlocked(u)]
    dirs = [str(unit_dirs(u)[2]) for u in units if unit_dirs(u)[2].is_dir()]
    env = dict(
        os.environ,
        OPSCOPILOT_PROJECT=str(PROJECT),
        WORKSHOP_STEP=str(int(unit[:2])),
        PYTHONDONTWRITEBYTECODE="1",
        LLM_PROVIDER="fake",
        EMBEDDINGS_BACKEND="fake",
        OPSCOPILOT_AUTO_APPROVE="1",
        PYTHONHASHSEED="0",
    )
    tests = WS / "tests"
    print(f"Checking step {label(unit)} (tests: {', '.join(units)}) on {PROJECT} …\n", flush=True)
    cmd = [sys.executable, "-m", "pytest", "-c", str(tests / "pytest.ini"), "--rootdir", str(tests)]
    code = subprocess.run([*cmd, *dirs], cwd=PROJECT, env=env).returncode
    arg = f"{int(unit[:2])}{'b' if unit.endswith('b') else ('a' if unit in ('03', '07') else '')}"
    if code == 0:
        # the agent reads this too: no pointer to the person's page, only who does what next
        print(
            f"\n✅ STEP {label(unit)}: tests PASSED.\n"
            "The manual checks are done by the person, not the agent — this shows them and asks\n"
            f"about each one:\n  ~/workshop/bin/zakoncz {arg}"
        )
    elif code == 1:
        print(
            f"\n❌ STEP {label(unit)}: NOT yet. The red tests are listed above — their names "
            "say what is missing.\nShow this result to the agent: \"Run ~/workshop/bin/sprawdz "
            f"{arg} and fix the code in ~/work/project without changing the tests.\""
        )
    else:
        print(
            f"\n❌ STEP {label(unit)}: NOT yet — the tests could not even start "
            f"(code {code}).\nUsually a module this step should add is missing, or the project "
            "has a syntax or import error. The first error message above says where."
        )
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
