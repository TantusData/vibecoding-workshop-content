#!/usr/bin/env python3
"""bin/zakoncz N — finish a step: the one predictable moment of "done".

Runs bin/sprawdz for the step (must be green), then walks the step's manual checks ONE BY ONE
and asks the participant whether each gave the expected result — green tests are not enough (a
trial run finished step 02 with green tests and a broken app). Any "no" leaves the step open.
Then it commits the project with a standard message, records the step as finished, and says what
comes next. Needs a person at a terminal (the agent never runs it; `--tak` is for the build's own
validation). `zakoncz 3a` / `7a` finish part A, which leads to part B.
"""

from __future__ import annotations

import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _warsztat import (  # noqa: E402
    DONE_FILE,
    PROJECT,
    TITLES,
    UNITS,
    check_arg,
    commit_all,
    confirm,
    ensure_project_repo,
    fail,
    label,
    manual_checks,
    parse,
    plain,
    unlocked,
)

USAGE = """Użycie: ~/workshop/bin/zakoncz N      (N = 1…8; części: 3a, 3b, 7a, 7b)

Kończy krok: sprawdza testy, pokazuje sprawdzenia ręczne, pyta o potwierdzenie i zapisuje
(commit) Twój projekt. Po tym poleceniu krok jest zrobiony."""


def main(argv: list[str]) -> int:
    unit = parse(argv, USAGE, part_a_of_split=True)
    if not unlocked(unit):
        fail(f"Krok {label(unit)} nie jest jeszcze rozpoczęty (~/workshop/bin/krok).", 4)
    ensure_project_repo(PROJECT)
    arg = check_arg(unit)
    print(f"1/3 Testy kroku {label(unit)}…", flush=True)
    r = subprocess.run(
        [sys.executable, str(Path(__file__).with_name("sprawdz")), arg],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        print(r.stdout[-3000:], r.stderr[-2000:])
        fail(f"\nKrok {label(unit)} nie jest jeszcze zrobiony — testy nie przechodzą (wyżej).")
    print("    ZALICZONE.\n")

    checks = manual_checks(unit)
    print(f"2/3 Sprawdzenia ręczne ({len(checks)}) — wykonaj każde i oceń wynik:\n")
    assume_yes = "--tak" in argv
    for i, check in enumerate(checks, 1):
        print(plain(check) + "\n")
        question = f"   Sprawdzenie {i}/{len(checks)}: wynik zgodny z oczekiwanym? (t/n): "
        if not confirm(question, assume_yes):
            print(
                f"\nKrok {label(unit)} nie jest zakończony: sprawdzenie {i} nie dało oczekiwanego "
                "wyniku.\nOpisz agentowi, co widać (objaw, nie przyczynę), i poproś "
                "najpierw o diagnozę. Potem uruchom zakoncz jeszcze raz."
            )
            return 1
        print()
    if not checks:
        print("(ten krok nie ma sprawdzeń ręcznych)\n")

    sha = commit_all(PROJECT, f"Krok {label(unit)}: zakończony — {TITLES[unit]}")
    with (PROJECT / ".git" / DONE_FILE).open("a", encoding="utf-8") as fh:
        fh.write(f"{unit} {sha} {time.strftime('%Y-%m-%d %H:%M')}\n")
    print(f"\n3/3 Zapisano (commit {sha[:7]}).\n\n✅ KROK {label(unit)} ZAKOŃCZONY.")

    nxt = UNITS[UNITS.index(unit) + 1] if unit != UNITS[-1] else None
    if nxt is None:
        print("To był ostatni krok. Gratulacje — projekt Tomasza jest skończony.")
    else:
        cmd = f"{int(nxt[:2])}{'b' if nxt.endswith('b') else ''}"
        print(f"\nNastępnie: krok {label(nxt)} — {TITLES[nxt]}")
        if nxt.endswith("b"):
            print("Zanim zaczniesz część B, prowadzący przeprowadzi odkrycie i krótką dyskusję.")
        print(f"Start:  ~/workshop/bin/krok {cmd}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
