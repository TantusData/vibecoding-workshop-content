# Copy to .env only for local development. On our code-server machines LITELLM_BASE_URL and
# LITELLM_VIRTUAL_KEY are already in the environment and win over .env — do not set them here.
LLM_PROVIDER=litellm                 # litellm | fake (tests)
LITELLM_BASE_URL=https://ide.tantusdata.com/v1
LITELLM_VIRTUAL_KEY=                 # the only secret — never commit
LLM_MODEL=bedrock-claude             # an alias on the key's allow-list
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
RANDOM_SEED=42
OPSCOPILOT_AUTO_APPROVE=0            # 1 = skip the human approval gate on NordDesk writes (tests only)
PYTHONHASHSEED=0

# retrieval
EMBEDDINGS_BACKEND=litellm           # litellm | fake (tests)
EMBEDDINGS_MODEL=titan-embed         # Titan Text Embeddings V2, 1024 dimensions
RAG_CHUNK_WORDS=120
RAG_CHUNK_OVERLAP=30
RAG_TITLE_PREFIX=1
RAG_TOP_K=4

# fake MCP servers (file-backed)
NORDDESK_STORE=var/norddesk.json
NORDWIKI_ROOT=data/wiki

# governance
OPSCOPILOT_AUDIT_LOG=var/audit.log

# conversation history
OPSCOPILOT_DB=var/opscopilot.db
OPSCOPILOT_HISTORY_MESSAGES=20
OPSCOPILOT_HISTORY_TOKENS=6000
OPSCOPILOT_HISTORY_TOOL_RESULTS=replay   # replay | drop | summarise
OPSCOPILOT_HISTORY_REFETCH=0             # 1 = state questions always re-fetch (the fix for stale answers)
# OPSCOPILOT_SESSION=                      # pin a conversation id (default: var/current_session)
